# Copy to .env.local (ignored by git) and fill in. Never put real values in this file.
# Every value below is a placeholder.

# Interface the process listens on. Default 127.0.0.1 (behind a reverse proxy).
HOST=127.0.0.1
# Port the process listens on; the reverse proxy forwards requests to it. Default 3110.
PORT=3110
# Exact public URL of the MCP resource (the audience of the access tokens), no trailing slash.
MCP_PUBLIC_URL=https://mcp.example.com/mcp
# Origin of the PatrolTech API, no trailing slash and no /api.
API_BASE_URL=https://api.example.com
# Expected issuer (iss) of the OAuth access tokens.
OAUTH_ISSUER=https://api.example.com
# JWKS used to verify the tokens. Optional: defaults to API_BASE_URL + /oauth/jwks.json.
OAUTH_JWKS_URL=
# Public URL of the PatrolTech dashboard (used in links shown to the user).
DASHBOARD_URL=https://dashboard.example.com
# Public URL of the PatrolTech web app (used in links shown to the user).
APP_BASE_URL=https://app.example.com
# Shared Redis (ioredis URL). REQUIRED when APP_ENVIRONMENT is production or staging: the lock
# around proposals must hold for every worker, and if Redis fails propose/confirm/cancel answer
# "busy". Without it (development and test only) rate limits and locks live in process memory.
REDIS_URL=
# Key prefix in Redis. Optional: defaults to APP_ENVIRONMENT.
REDIS_NAMESPACE=
# Environment: production | staging | development | test.
APP_ENVIRONMENT=development
# Log level: debug | info | warn | error. Default info. The audit line (mcp.tool_call) and the
# heartbeat (mcp.heartbeat) are written at any level.
LOG_LEVEL=info
# Service name written in every log line ("service"). Optional: default mcp-server.
SERVICE_NAME=
# Domain verification token for the ChatGPT apps directory, served at
# /.well-known/openai-apps-challenge. Optional: without it that path answers 404.
OPENAI_APPS_CHALLENGE=
